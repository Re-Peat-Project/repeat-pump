<mxfile host="repeat-pump"><diagram id="pump" name="repeat-pump method"><mxGraphModel dx="1600" dy="1420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1420" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Rewetting interventions, RE-PEAT: repeat-pump method (2026-10-27)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Any KHG from its code:&lt;/b&gt; scripts/khg_run_config.py &amp;lt;KHG folder&amp;gt; | --all &amp;lt;_khg&amp;gt; writes _khg/&amp;lt;code&amp;gt;_&amp;lt;name&amp;gt;/05_pump/run_config.yaml from the KHG folder; repeat-pump run --config … (CLI) or the QGIS wizard (same engine). Stages 1-12 below; review stops after 2, 6 and 9. Proposed defaults come from configs/proposed_defaults.yaml and are marked as such." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="INPUTS" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c5" value="STAGES (repeat_pump/core)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c6" value="OUTPUTS  (_khg/&amp;lt;khg&amp;gt;/05_pump/)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c7" value="READ BY" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="88" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="A. Canal network and terrain (stages 1-5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="115" width="1510" height="330" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;DTM&lt;/b&gt; 01_dem (LiDAR first; DeltaDTM, DEMNAS)&lt;br&gt;inputs.dtm.source sets the suggested vertical error (lidar 0.3 m, deltadtm 0.49, demnas 4.97)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="340" height="62" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Canals&lt;/b&gt; 00_inputs/canals.gpkg (KODE_KANAL 1 primer, 2 sekunder, 3 tersier)&lt;br&gt;existing sekat 00_inputs/blocks.gpkg, rivers" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="215" width="340" height="52" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Sub-KHG units and ranking&lt;/b&gt; 02_delineation, 04_prioritisation (subkhg_priority.csv, unit_prioritas.gpkg)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="340" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Moisture&lt;/b&gt; (latest NDMI), &lt;b&gt;burn area&lt;/b&gt;, &lt;b&gt;peat depth&lt;/b&gt; (optional: a criterion without its layer gets weight 0)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="335" width="340" height="52" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. Load and validate&lt;/b&gt;: clip to the selected sub-KHG (top n by rank), CRS, DTM type (DSM refused), accuracy warning" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="145" width="400" height="52" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;2. Topology&lt;/b&gt;: class filter (primer, sekunder; tersier optional), snap gaps, dangles, canal edits" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fdecea;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="420" y="205" width="400" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;3. Hydro&lt;/b&gt;: burn canals into the DTM, fill, flow accumulation (WhiteboxTools)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="265" width="400" height="42" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;4-5. Segments and profiles&lt;/b&gt;: 500 m segments; land profile every sample step; flow direction from slope, rivers, else flow accumulation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="315" width="400" height="52" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;&amp;lt;name&amp;gt;.gpkg&lt;/b&gt;: inputs_clipped_*, canals_clean, qa_topology_dangles, qa_topology_gaps, canal_segments, canal_profiles" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="175" width="330" height="62" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;&amp;lt;name&amp;gt;_work/&lt;/b&gt; dtm_conditioned.tif, flow_acc.tif" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="245" width="330" height="42" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="Key" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="145" width="250" height="26" as="geometry"/></mxCell><mxCell id="c29" value="input" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="1260" y="175" width="250" height="26" as="geometry"/></mxCell><mxCell id="c30" value="stage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="1260" y="207" width="250" height="26" as="geometry"/></mxCell><mxCell id="c31" value="stage with a review stop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fdecea;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="1260" y="239" width="250" height="26" as="geometry"/></mxCell><mxCell id="c32" value="optional stage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f7f7f7;strokeColor=#aaaaaa;fontColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1260" y="271" width="250" height="26" as="geometry"/></mxCell><mxCell id="c33" value="parameters" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f3f3f3;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="1260" y="303" width="250" height="26" as="geometry"/></mxCell><mxCell id="c34" value="output" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="1260" y="335" width="250" height="26" as="geometry"/></mxCell><mxCell id="c35" value="B. Where the sekat go (stages 6-7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="460" width="1510" height="300" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;6. Prioritise&lt;/b&gt;: need score per segment (dryness in a ring buffer, upstream flow, burn, peat depth), min-max, direct or AHP weights, sensitivity; or the KLH 1-3 scoring" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fdecea;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="400" height="62" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;7. Sekat&lt;/b&gt;: head rule, a block where the land rises dA = 0.40 m (PP 57/2016), spacing js = dA / slope, at most 500 m; existing sekat snapped; type reinforced from 5 % slope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="562" width="400" height="90" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Balance&lt;/b&gt; (canal-rise objective, Urzainki 2020): rank blocks by the extra canal water each adds, from a dry level 1.0 m below the land, capped at the surface; keep the fewest giving &lt;b&gt;90 %&lt;/b&gt; (target_rise_share) or max_blocks" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="662" width="400" height="88" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Parameters&lt;/b&gt;: dA 0.40 m · max spacing 500 m · min spacing 100 m · target share 0.9 (POLICY) · balance drawdown 1.0 m · reinforced from 5 %" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f3f3f3;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="340" height="70" as="geometry"/></mxCell><mxCell id="c40" value="canal_segments (need_score, rank), qa_sensitivity" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="490" width="330" height="42" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;sekat_proposed&lt;/b&gt; (kept; benefit_rank, gain_m2, cum_share, js_m, sekat_type) · &lt;b&gt;sekat_low_benefit&lt;/b&gt; · sekat_existing_assessed · &lt;b&gt;sekat_reach&lt;/b&gt;: canal stretch each kept block holds, drawn upstream (rise_m, depth_m, burnt_frac)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="562" width="330" height="100" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c16" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;dashed=1;" edge="1" parent="1" source="c39" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c36" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c38" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="C. Pumping (stages 8-10, pumping.enabled; off when no river has a perennial flag or dry-season level)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="775" width="1510" height="150" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;8. Network&lt;/b&gt; of canals, rivers and sekat · &lt;b&gt;9. Routing&lt;/b&gt;: head-aware least cost from river intakes to the highest node of each target cluster (Steiner or per target), gates where routes cross sekat · &lt;b&gt;10. Pumps&lt;/b&gt;: demand from deficit and specific yield, units per station" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f7f7f7;strokeColor=#aaaaaa;fontColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="805" width="400" height="110" as="geometry"/></mxCell><mxCell id="c50" value="network_nodes, network_edges, pump_sources, pump_targets, &lt;b&gt;pump_routes&lt;/b&gt; (drawn intake to target), sekat_scope, pump_stations, gates_required" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="805" width="330" height="90" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;dashed=1;" edge="1" parent="1" source="c38" target="c49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="E. Interventions, budget and report (stage 12, always last)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="1060" width="1510" height="330" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Sub-KHG indicators&lt;/b&gt; unit_prioritas.gpkg: i_protected, u_ndmi, burned_ever_frac, f_reach, f_water_dist, canal density" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="1090" width="340" height="62" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Neraca air&lt;/b&gt; 03_neraca/runs/balance/neraca_map.gpkg (repeat-neraca-map): KHG deficit, monthly balance, SiTMAT stations" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="1160" width="340" height="62" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Unit prices&lt;/b&gt; budget.* [low, central, high] Rp, sources in repeat_pump/data/budget_sources.csv (to verify)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="1230" width="340" height="62" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;12a. Interventions&lt;/b&gt; per sub-KHG (held water from stage 7), first rule that holds: protected peat ≥ 0.5 → close or backfill canals · dry (NDMI &amp;lt; 0.3) or burnt (≥ 0.25) and canal reach &amp;lt; 0.4 → revegetation and fire readiness · sekat fall short (held &amp;lt; 0.5 of deficit) with water ≤ 5 km → sekat and water supply · else, dry or burnt → sekat and deep wells · reach ≥ 0.4 → sekat · else maintain. Held = rise × Sy 0.15 × 600 m" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="1090" width="400" height="132" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;12b. Budget&lt;/b&gt;: kept sekat by type (or the KLH IPG estimate where none were placed), km of canal to close, ha to revegetate, wells (burnt ha / π 200²), pumps and fuel × prices" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="1230" width="400" height="70" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;12c. Report&lt;/b&gt;: run_report.md/json; repeat-pump report-html (map with animation, charts, tables); KLH print layouts A0-A4" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="1310" width="400" height="62" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;interventions&lt;/b&gt; layer, interventions.csv (class, reasons, class without the protected rule, held_m3, deficit_m3)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="1090" width="330" height="62" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;budget&lt;/b&gt; layer, budget.csv, &lt;b&gt;budget_sources.csv&lt;/b&gt; (register with status and run value)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="1160" width="330" height="62" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;run_report.md&lt;/b&gt;, run_report.json, &lt;b&gt;report.html&lt;/b&gt; (one file, EN/ID, light/dark), layout PNG/PDF and .qpt templates" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="1230" width="330" height="90" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;KLH&lt;/b&gt;: plan, budget request, field check of sekat sites and prices" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5ecf7;strokeColor=#8a5a9c;" vertex="1" parent="1"><mxGeometry x="1260" y="1160" width="250" height="90" as="geometry